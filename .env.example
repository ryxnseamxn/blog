# Copy to `.env`. Read by both `docker compose` and Expo.
# Everything is optional for local web development.

# --- docker compose ---

# Require this key on the API's admin endpoints. Leave empty to keep them open locally.
ADMIN_API_KEY=

# Your computer's LAN IP (e.g. 192.168.1.20), needed only to run the app on a physical
# phone with Expo Go. Find it with: ipconfig getifaddr en0
LAN_IP=

# --- Expo (EXPO_PUBLIC_* values are inlined into the app bundle, so never put secrets here) ---

# Friendsgiving API. Defaults to http://localhost:5080 (http://10.0.2.2:5080 on the
# Android emulator). On a physical phone, use http://<LAN_IP>:5080.
EXPO_PUBLIC_API_BASE_URL=

# Public web URL of this app, used in invite links from the admin screen.
# Defaults to the current web origin, or an app deep link on native.
EXPO_PUBLIC_APP_URL=
